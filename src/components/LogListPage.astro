---
import { url } from '../lib/url';
// 制作ログ一覧の1ページ分（/logs/ と /logs/page/n/ で共通）
import BaseLayout from '../layouts/BaseLayout.astro';
import Impressions from './Impressions.astro';
import { formatDate, getLogPhotos, type Log } from '../lib/stats';
import { logsPageUrl } from '../lib/pagination';

interface Props {
  logs: Log[];
  current: number;
  total: number;
  count: number;
}
const { logs, current, total, count } = Astro.props;
const pages = Array.from({ length: total }, (_, i) => i + 1);
---
<BaseLayout title={current === 1 ? '制作ログ' : `制作ログ（${current}ページ目）`}>
  <section class="card">
    <h1>制作ログ</h1>
    <p>制作ごとの記録。何を試して、どう感じたか。</p>
    <p class="muted">全{count}件{total > 1 && `・${current} / ${total}ページ`}</p>
  </section>

  {logs.map((log) => {
    const photos = getLogPhotos(log);
    return (
      <article class="card log-card">
        <div class="log-card-body">
          {photos.length > 0 && (
            <a class="log-thumb" href={url(`/logs/${log.id}/`)} tabindex="-1" aria-hidden="true">
              <img src={photos[0].src} alt="" loading="lazy" decoding="async" />
            </a>
          )}
          <div class="log-card-main">
            <h2>
              <a href={url(`/logs/${log.id}/`)}>{formatDate(log.data.date)}</a>
              {photos.length > 0 && <span class="photo-count">写真{photos.length}枚</span>}
            </h2>
            <dl class="log-meta">
              <dt>件名</dt><dd>{log.data.title}</dd>
              <dt>試した技術</dt>
              <dd>
                {log.data.techniques.map((t) => <a class="tag" href={url(`/techniques/${t.id}/`)}>{t.id}</a>)}
              </dd>
            </dl>
            <Impressions log={log} />
          </div>
        </div>
      </article>
    );
  })}

  {total > 1 && (
    <nav class="pager" aria-label="ページ切り替え">
      {current > 1
        ? <a class="pager-step" href={logsPageUrl(current - 1)}>← 新しいログ</a>
        : <span class="pager-step" aria-hidden="true"></span>}
      <ol class="pager-pages">
        {pages.map((n) => (
          <li>
            {n === current
              ? <span aria-current="page">{n}</span>
              : <a href={logsPageUrl(n)}>{n}</a>}
          </li>
        ))}
      </ol>
      {current < total
        ? <a class="pager-step" href={logsPageUrl(current + 1)}>古いログ →</a>
        : <span class="pager-step" aria-hidden="true"></span>}
    </nav>
  )}
</BaseLayout>
