---
// 経験値を★で表示する。分母（最大値）は表示しない。
interface Props {
  value: number;
}
const { value } = Astro.props;
const MAX_STARS = 10; // これを超えたら「★×N」表記にする
---
<span class="stars" aria-label={`経験値 ${value}`}>
  {value === 0 && <span class="stars-empty">まだこれから</span>}
  {value > 0 && value <= MAX_STARS && '★'.repeat(value)}
  {value > MAX_STARS && <>★<small>×{value}</small></>}
</span>
