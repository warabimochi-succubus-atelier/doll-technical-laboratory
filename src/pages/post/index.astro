---
// 投稿アプリ（PWA）。ナビゲーションには出さず、検索エンジンにも載せない。
// 仕様は docs/posting-app-spec.md
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import { categories, fields } from '../../data/categories';
import { getLogs } from '../../lib/stats';
import { url } from '../../lib/url';

const logs = await getLogs();
const techniques = await getCollection('techniques');

// これまでの件名（新しいログに出てきた順）と、カテゴリ別の技法
const titles = [...new Set(logs.map((l) => l.data.title))];
const groups = categories
  .map((category) => ({
    category,
    items: techniques
      .filter((t) => t.data.category === category)
      .sort((a, b) => a.data.order - b.data.order)
      .map((t) => ({ id: t.id, name: t.data.name })),
  }))
  .filter((g) => g.items.length > 0);

const siteUrl = new URL(url('/'), Astro.site).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>制作ログを投稿 | どーる技術研究室</title>
    <link rel="manifest" href={url('/post/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={url('/post-apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="研究室投稿" />
    <meta name="theme-color" content="#c9577a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&family=Zen+Old+Mincho:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="post-app" data-site-url={siteUrl} data-fields={JSON.stringify(fields)}>
    <header class="post-header">
      <h1>制作ログを投稿</h1>
      <button type="button" class="post-icon-btn" id="open-settings" aria-label="設定">⚙</button>
    </header>

    <main class="post-main">
      <p class="post-banner" id="settings-banner" hidden>
        はじめに<button type="button" class="post-link-btn" data-open-settings>設定</button>から GitHub のトークンを入力してください。
      </p>

      <nav class="post-tabs" aria-label="画面の切り替え">
        <button type="button" class="post-tab" id="tab-new" aria-pressed="true">投稿する</button>
        <button type="button" class="post-tab" id="tab-past" aria-pressed="false">過去の投稿</button>
        <button type="button" class="post-tab" id="tab-tech" aria-pressed="false">技術リスト</button>
      </nav>

      <section id="tech-view" hidden>
        <p class="post-note" id="tech-intro">技法の追加・名前の変更・並べ替え・削除ができます。名前を変えると、その技法を使っている制作ログも自動で書き換えます。</p>
        <button type="button" class="post-btn post-mode-btn" id="tech-mode">カテゴリ・研究分野を編集</button>
        <p class="post-error" id="tech-error" role="alert" hidden></p>
        <p class="post-status" id="tech-status" role="status" aria-live="polite"></p>
        <div id="tech-list"></div>
        <button type="button" class="post-btn post-more" id="tech-add">＋ 技法を追加</button>
        <button type="button" class="post-btn post-more" id="field-add" hidden>＋ 研究分野を追加</button>
      </section>

      <section id="past-view" hidden>
        <p class="post-note">新しい順に表示します。投稿した直後の、サイトにまだ反映されていないログも出ます。</p>
        <p class="post-error" id="past-error" role="alert" hidden></p>
        <ul class="post-past-list" id="past-list"></ul>
        <button type="button" class="post-btn post-more" id="past-more" hidden>もっと見る</button>
      </section>

      <form id="post-form" novalidate>
        <p class="post-editing" id="editing-banner" hidden>
          <span id="editing-label"></span>
          <button type="button" class="post-link-btn" id="cancel-edit">編集をやめる</button>
        </p>
        <section class="card">
          <label class="post-photo-add">
            <input type="file" id="photo-input" accept="image/*" multiple />
            <span>＋ 写真を追加（最大5枚）</span>
          </label>
          <ul class="post-photo-list" id="photo-list"></ul>
          <p class="post-note">位置情報などの撮影データは、送信前に自動で削除されます。写真の下には「下塗り」「乾燥後」などの短い見出し（20文字まで）を付けられます。</p>
          <label class="post-check" id="check-background-row">
            <input type="checkbox" id="check-background" />
            写真の背景に、個人情報や見せたくないものが写っていない
          </label>
        </section>

        <section class="card post-fields">
          <label class="post-field">
            <span>件名 <em>必須</em></span>
            <input type="text" id="title" list="title-list" autocomplete="off" placeholder="DD桜 / ピンクのレジンアイ" />
            <datalist id="title-list">
              {titles.map((t) => <option value={t} />)}
            </datalist>
          </label>

          <label class="post-field">
            <span>日付</span>
            <input type="date" id="date" />
          </label>

          <fieldset class="post-field" id="technique-chips">
            <legend>実験技術</legend>
            {groups.map((g) => (
              <div class="post-tech-group">
                <p class="post-tech-category">{g.category}</p>
                <div class="post-chips">
                  {g.items.map((t) => (
                    <label class="post-chip">
                      <input type="checkbox" name="technique" value={t.id} />
                      <span>{t.name}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </fieldset>

          <label class="post-field">
            <span>使用材料 <small>道具も含む・1行に1つ</small></span>
            <textarea id="used" rows="3"></textarea>
          </label>
          <label class="post-field">
            <span><span class="reaction">どやぁ</span> <small>成功・1行に1つ</small></span>
            <textarea id="doya" rows="2"></textarea>
          </label>
          <label class="post-field">
            <span><span class="reaction">ぐぬぬ</span> <small>苦戦・1行に1つ</small></span>
            <textarea id="gunu" rows="2"></textarea>
          </label>
          <label class="post-field">
            <span>メモ</span>
            <textarea id="memo" rows="3"></textarea>
          </label>
        </section>

        <section class="card">
          <label class="post-check">
            <input type="checkbox" id="check-public" />
            公開サイトに載ることを理解している
          </label>
          <p class="post-error" id="form-error" role="alert" hidden></p>
          <button type="submit" class="post-submit" id="submit">投稿</button>
          <button type="button" class="post-delete" id="delete-log" hidden>このログを削除</button>
          <p class="post-status" id="status" role="status" aria-live="polite"></p>
        </section>
      </form>
    </main>

    <dialog class="post-settings" id="settings">
      <form method="dialog" id="settings-form" novalidate>
        <!-- 開いたときは見出しにフォーカスを置く（入力欄に置くと iPhone でキーボードが出てしまうため） -->
        <h2 tabindex="-1" autofocus class="post-dialog-title">GitHub の設定</h2>
        <label class="post-field">
          <span>リポジトリ</span>
          <input type="text" id="repo" autocomplete="off" spellcheck="false" />
        </label>
        <label class="post-field">
          <span>トークン（Fine-grained Personal Access Token）</span>
          <input type="password" id="token" autocomplete="off" spellcheck="false" placeholder="github_pat_…" />
        </label>
        <p class="post-note">
          <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">トークンを作る</a>
          ときは、Repository access を<strong>このリポジトリだけ</strong>、Permissions を <strong>Contents: Read and write</strong> だけにし、有効期限を付けてください。
          トークンはこの端末のブラウザ内にだけ保存され、GitHub 以外には送られません。
        </p>
        <p class="post-error" id="settings-error" role="alert" hidden></p>
        <div class="post-settings-actions">
          <button type="button" class="post-link-btn" id="delete-token">トークンを削除</button>
          <span class="post-spacer"></span>
          <button type="button" class="post-btn" id="cancel-settings">閉じる</button>
          <button type="submit" class="post-btn post-btn-primary" id="save-settings">確認して保存</button>
        </div>
      </form>
    </dialog>

    <dialog class="post-settings" id="tech-dialog">
      <form method="dialog" id="tech-form" novalidate>
        <h2 id="tech-dialog-title">技法を追加</h2>
        <label class="post-field">
          <span>技法名</span>
          <input type="text" id="tech-name" autocomplete="off" placeholder="筆先でトントン" />
        </label>
        <label class="post-field">
          <span>カテゴリ</span>
          <select id="tech-category">
            {fields.map((f) => (
              <optgroup label={f.name}>
                {f.categories.map((c) => <option value={c}>{c}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <label class="post-field">
          <span>メモ <small>任意・技法のページに表示</small></span>
          <textarea id="tech-memo" rows="4"></textarea>
        </label>
        <p class="post-note" id="tech-rename-note" hidden>名前を変えると、この技法を使っている制作ログも書き換わり、技法のページの URL も変わります。</p>
        <p class="post-error" id="tech-dialog-error" role="alert" hidden></p>
        <div class="post-settings-actions">
          <button type="button" class="post-link-btn post-danger-link" id="tech-delete">この技法を削除</button>
          <span class="post-spacer"></span>
          <button type="button" class="post-btn" id="tech-cancel">閉じる</button>
          <button type="submit" class="post-btn post-btn-primary" id="tech-save">保存</button>
        </div>
      </form>
    </dialog>

    <dialog class="post-settings" id="cat-dialog">
      <form method="dialog" id="cat-form" novalidate>
        <h2 id="cat-dialog-title">カテゴリを追加</h2>
        <label class="post-field">
          <span>カテゴリ名</span>
          <input type="text" id="cat-name" autocomplete="off" placeholder="ウィッグ" />
        </label>
        <label class="post-field">
          <span>研究分野</span>
          <select id="cat-field"></select>
        </label>
        <p class="post-note" id="cat-rename-note" hidden>カテゴリ名を変えると、このカテゴリの技法ファイルもまとめて書き換えます。</p>
        <p class="post-error" id="cat-dialog-error" role="alert" hidden></p>
        <div class="post-settings-actions">
          <button type="button" class="post-link-btn post-danger-link" id="cat-delete">このカテゴリを削除</button>
          <span class="post-spacer"></span>
          <button type="button" class="post-btn" id="cat-cancel">閉じる</button>
          <button type="submit" class="post-btn post-btn-primary" id="cat-save">保存</button>
        </div>
      </form>
    </dialog>

    <script>
      import { initPostApp } from '../../lib/post/app';
      initPostApp();
    </script>
  </body>
</html>
