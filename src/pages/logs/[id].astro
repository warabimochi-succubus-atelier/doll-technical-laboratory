---
import { url } from '../../lib/url';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Impressions from '../../components/Impressions.astro';
import LogPhotos from '../../components/LogPhotos.astro';
import { formatDate, getTechniqueNames } from '../../lib/stats';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  return logs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const date = formatDate(entry.data.date);
const techniqueNames = await getTechniqueNames();
---
<BaseLayout title={`${date} ${entry.data.title}`}>
  <article class="card">
    <p class="muted"><time>{date}</time></p>
    <h1>{entry.data.title}</h1>

    <LogPhotos log={entry} />

    <h2>試した技術</h2>
    <p>{entry.data.techniques.map((t) => <a class="tag" href={url(`/techniques/${t.id}/`)}>{techniqueNames.get(t.id) ?? t.id}</a>)}</p>

    <h2>感想</h2>
    <Impressions log={entry} />

    <div class="prose"><Content /></div>
  </article>
  <p class="more"><a href={url('/logs/')}>← 制作ログ一覧へ</a></p>
</BaseLayout>
