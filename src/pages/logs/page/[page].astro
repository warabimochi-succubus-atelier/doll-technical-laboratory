---
// 制作ログ一覧の2ページ目以降（1ページ目は /logs/）
import LogListPage from '../../../components/LogListPage.astro';
import { getLogs } from '../../../lib/stats';
import { splitPages } from '../../../lib/pagination';

export async function getStaticPaths() {
  const logs = await getLogs();
  const pages = splitPages(logs);
  return pages.slice(1).map((items, i) => ({
    params: { page: String(i + 2) },
    props: { items, current: i + 2, total: pages.length, count: logs.length },
  }));
}

const { items, current, total, count } = Astro.props;
---
<LogListPage logs={items} current={current} total={total} count={count} />
