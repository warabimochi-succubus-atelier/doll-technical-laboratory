---
import { url } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTechniquesByCategory } from '../../lib/stats';
import { fields } from '../../data/categories';

const groups = await getTechniquesByCategory();
// 研究分野ごとにカテゴリをまとめる
const sections = fields.map((f) => ({
  name: f.name,
  groups: groups.filter((g) => (f.categories as readonly string[]).includes(g.category)),
}));
---
<BaseLayout title="技術リスト">
  <section class="card">
    <h1>技術リスト</h1>
    <p>試してみたい技法の一覧。制作ログで使うと自動でチェックが付きます。</p>
  </section>

  {sections.map((s) => (
    <section class="card">
      <h2>{s.name}</h2>
      {s.groups.map((g) => (
        <div class="tech-category">
          <h3>{g.category}</h3>
          {g.items.length === 0 ? (
            <p class="muted">まだ技法が登録されていません。</p>
          ) : (
            <ul class="tech-list">
              {g.items.map(({ entry, count }) => (
                <li class={count > 0 ? 'tried' : ''}>
                  <a href={url(`/techniques/${entry.id}/`)}>
                    <span class="check" aria-hidden="true">{count > 0 ? '☑' : '☐'}</span>
                    <span class="name">{entry.data.name}</span>
                    {count > 0 && <span class="count">{count}回</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>
  ))}
</BaseLayout>
