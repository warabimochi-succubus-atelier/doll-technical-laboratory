---
import { url } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { reactions } from '../data/reactions';
import { fields } from '../data/categories';
// 文言は docs/concept.md と docs/policy.md（運用方針の原文）を短くまとめたもの

// 研究分野とカテゴリは src/data/categories.ts から作る。技法がまだ1つもない研究分野は「今後扱う予定」と表示する
const techniques = await getCollection('techniques');
const fieldList = fields.map((f) => ({
  name: f.name,
  items: f.categories,
  planned: !techniques.some((t) => (f.categories as readonly string[]).includes(t.data.category)),
}));
---
<BaseLayout title="この研究室について">
  <section class="about-visual">
    <img src={url('/images/about.webp')} alt="ドールの道具に囲まれた研究室の様子" />
  </section>

  <section class="card">
    <h1>この研究室について</h1>
    <p class="lead">ドールメイクに正解はない。だから、研究する。</p>
    <p>
      どーる技術研究室は、わらびもちサキュバス工房の研究ノートです。
      作品を見せる場所ではなく、試したことと、その結果を残す場所です。
    </p>
    <p>
      未来の自分が読み返して助かるように書いています。
    </p>
  </section>

  <section class="card">
    <h2>研究理念</h2>
    <p>ここでは、次の2つをどちらも研究として記録します。</p>
    <ul class="stance-list">
      {reactions.map((r) => (
        <li><span class="stance-word">{r.key}</span><span class="stance-note">{r.note}</span></li>
      ))}
    </ul>
    <div class="motto">
      <p class="motto-main">ぐぬぬは研究成果です。</p>
      <p class="motto-sub">うまくいかなかった理由と次の一手を残せば、それは次のどやぁへの途中経過になります。</p>
    </div>
  </section>

  <section class="card">
    <h2>研究の進め方</h2>
    <p>
      制作のたびに<strong>「今日はどの技法を試してみるか」</strong>を意識して取り組み、<a href={url('/logs/')}>制作ログ</a>に残します。
      感想は どやぁ／ぐぬぬ に分けて書き、トップページの★として積み上がります。
      試した技法には<a href={url('/techniques/')}>技術リスト</a>でチェックが付きます。
    </p>
    <p>
      更新頻度は決めていません。まとめておきたいことが出てきたら、技法のメモに残します。
    </p>
  </section>

  <section class="card">
    <h2>研究分野</h2>
    <div class="field-grid">
      {fieldList.map((f) => (
        <div class="field">
          <h3>
            {f.name}
            {f.planned && <span class="tag">今後扱う予定</span>}
          </h3>
          <ul>
            {f.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="card closing">
    <h2>最後に</h2>
    <p>「あの頃、ここでぐぬぬしてたな」と読み返せたら、この研究室は成功です。</p>
    <p class="lead">今日のぐぬぬは、明日のどやぁ。</p>
  </section>

  <section class="card">
    <h2>運営</h2>
    <p>わらびもちサキュバス工房</p>
    <p>GitHub：<a href="https://github.com/warabimochi-succubus-atelier">github.com/warabimochi-succubus-atelier</a></p>
  </section>
</BaseLayout>
