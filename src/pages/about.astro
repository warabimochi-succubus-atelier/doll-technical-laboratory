---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
// 文言は docs/concept.md と docs/policy.md（運用方針の原文）をもとにしている

import { reactions } from '../data/reactions';

const fields = [
  {
    name: 'ドールメイク研究',
    items: ['眉毛', 'アイライン・まつ毛','チーク表現', '陰影表現', '下書き手法'],
  },
  {
    name: 'レジンアイ研究',
    items: ['虹彩表現', '研磨工程', 'コーティング', '材料比較', '工法改善'],
  },
  {
    name: '撮影研究',
    items: ['スマートフォン撮影', '自然光撮影', '室内照明撮影', '背景研究'],
    planned: true,
  },
  {
    name: '道具研究',
    items: ['筆', 'つまようじ', 'シャープペン', '研磨工具', '拡大鏡や照明機材'],
    planned: true,
  },
];
---
<BaseLayout title="この研究室について">
  <section class="about-visual">
    <img src="/images/about.webp" alt="ドールの道具に囲まれた研究室の様子" />
  </section>

  <section class="card">
    <h1>この研究室について</h1>
    <p class="lead">ドールメイクに正解はない。だから、研究する。</p>
    <p>
      どーる技術研究室は、わらびもちサキュバス工房の技術記録プロジェクトです。
      ドールメイクとレジンアイ製作を中心に、ゆくゆくは撮影や工具・材料の検証まで、
      ドール制作に関する試行錯誤を記録し、知識を蓄積していくために運営しています。
    </p>
    <p>
      ここは作品を展示するギャラリーではありません。
      成功も失敗も含めて記録し、未来の自分が参照できる研究ノートとして育てていきます。
    </p>
  </section>

  <section class="card">
    <h2>研究理念</h2>
    <p>
      技術は突然身につくものではありません。
      理想通りに描けなかった日、削りすぎてしまった日、思った色が出なかった日、
      何度やっても左右が揃わなかった日。
      そうした試行錯誤の積み重ねで、少しずつ前進していきます。
    </p>
    <p>本研究室では、次のすべてを研究活動として扱います。</p>
    <ul class="stance-list">
      {reactions.map((r) => (
        <li><span class="stance-word">{r.key}</span><span class="stance-note">{r.note}</span></li>
      ))}
    </ul>

    <div class="motto">
      <p class="motto-main">ぐぬぬは研究成果です。</p>
      <p class="motto-sub">ぐぬぬ ＝ 失敗 ではなく、ぐぬぬ ＝ 次のどやぁへ至る途中経過</p>
    </div>

    <p>理想通りの結果が得られなかったとしても、</p>
    <ul>
      <li>なぜそうなったのか</li>
      <li>何を試したのか</li>
      <li>どこで問題が起きたのか</li>
      <li>次回どう改善するのか</li>
    </ul>
    <p>
      を記録すれば、それは貴重な知見になります。
      アイラインがうまく引けなかった日も、レジンアイを削りすぎた日も、
      写真が思ったほど可愛く写らなかった日も、失敗ではなく研究データです。
    </p>
  </section>

  <section class="card">
    <h2>誰のための研究室か</h2>
    <p>
      この研究室は、検索順位のためにも、アクセス数のためにも、AIに引用されるためにも存在しません。
    </p>
    <p>
      昨日の自分が困ったことを記録し、今日の自分が試したことを残し、
      未来の自分が助かるために存在します。
    </p>
    <p>
      その記録が偶然どこかの誰かの役に立ったなら、それはとても幸運なことです。
      けれどその前に──
    </p>
    <p class="lead">まず最初に助けるべき研究員は、自分自身です。</p>
  </section>

  <section class="card">
    <h2>目的</h2>
    <ul>
      <li>ドール制作技術を継続的に向上させる</li>
      <li>次に試すことを見つけ、技術の引き出しを増やす</li>
      <li>制作過程や検証結果を体系的に蓄積する</li>
      <li>未来の自分へ技術資料を残す</li>
    </ul>
  </section>

  <section class="card">
    <h2>研究の進め方</h2>
    <p>
      ドールメイクは「眉毛だけ」「アイラインだけ」のように部分単位で作業することは少なく、
      1回の制作で複数の要素を同時に進めることがほとんどです。
    </p>
    <p>
      そこで、制作のたびに<strong>「今日はどの技法を試してみるか」</strong>を意識して取り組み、
      その結果を<a href="/logs/">制作ログ</a>に残しています。
      感想は「どやぁ」「ぐぬぬ」「はて？」に分けて書き、トップページの★として少しずつ積み上がっていきます。
      試した技法は<a href="/techniques/">技術リスト</a>にチェックされ、試した回数も記録されます。
    </p>
  </section>

  <section class="card">
    <h2>研究分野</h2>
    <div class="field-grid">
      {fields.map((f) => (
        <div class="field">
          <h3>
            {f.name}
            {f.planned && <span class="tag">今後扱う予定</span>}
          </h3>
          <ul>
            {f.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="muted">
      現在の技術リストで記録しているカテゴリ：{categories.join('／')}
    </p>
  </section>

  <section class="card">
    <h2>記事と更新について</h2>
    <p>
      更新頻度は定めません。研究室は記事を書くために存在するのではなく、研究するために存在します。
      何かを試したら、失敗したら、成功したら、疑問が生まれたら記録する。その積み重ねを大切にします。
    </p>
    <p>
      制作ログを続けるうちに「これはまとめておきたい」と思うテーマが出てきたら、研究メモとして記事にします。
    </p>
    <p class="muted">例：平行眉研究メモ／タレ目研究メモ／下まぶた表現研究メモ</p>
  </section>

  <section class="card">
    <h2>目標</h2>
    <p>「今日はメイクするか」ではなく、</p>
    <p class="lead">「今日はまだやったことのない技法をひとつ試してみるか」</p>
    <p>
      と思える研究室にすること。完成品を増やすだけでなく、
      少しずつ技術の引き出しを増やしていくことを目標にしています。
    </p>
  </section>

  <section class="card closing">
    <h2>最後に</h2>
    <p>
      この研究室は、完成された技術を語る場所ではありません。
      一人のドール趣味人が「どやぁ」と「ぐぬぬ」を繰り返しながら、少しずつ成長していく過程を残す場所です。
    </p>
    <p>
      未来の自分が昔の記事を読み返して
      「あの頃も同じところでぐぬぬしていたな」と思えたなら、この研究室は成功です。
    </p>
    <p class="lead">研究に失敗はありません。<br />あるのは、次の研究ログのネタだけです。</p>
  </section>

  <section class="card">
    <h2>運営</h2>
    <p>わらびもちサキュバス工房</p>
    <p class="muted">※ 連絡先・SNS などは準備中です。</p>
  </section>
</BaseLayout>
